#
# Variables shared between all environments (see src/config/env.zod.ts, paramsEnvSchema).
# NODE_ENV and DEPLOY_ENV are environment-specific and are defined in each
# .env.<environment> file instead.
#

# We are using the dotenv-flow package to manage environment variables
# Prefer using .env.development.local or .env.local over .env
# see https://www.npmjs.com/package/dotenv-flow?activeTab=readme#files-under-version-control

API_IP_RATE_LIMITER_POINTS_PER_MINUTE=1000
APPLICATION_NAME=ProConnect
APP_IP_RATE_LIMITER_POINTS_PER_MINUTE=100
CERTIFICATION_DIRIGEANT_MAX_AGE_IN_MINUTES=1440
HOST=http://localhost:3000
HTTP_CLIENT_TIMEOUT=55000
LOG_LEVEL=info
MAGIC_LINK_TOKEN_EXPIRATION_DURATION_IN_MINUTES=60
MAX_DURATION_BETWEEN_TWO_EMAIL_ADDRESS_VERIFICATION_IN_MINUTES=129600
MAX_SUGGESTED_ORGANIZATIONS=3
MIN_DURATION_BETWEEN_TWO_VERIFICATION_CODE_SENDING_IN_SECONDS=1200
OFFICIAL_CONTACT_EMAIL_VERIFICATION_TOKEN_EXPIRATION_DURATION_IN_MINUTES=60
PORT=3000
RECENT_LOGIN_INTERVAL_IN_SECONDS=900
RESET_PASSWORD_TOKEN_EXPIRATION_DURATION_IN_MINUTES=60
SESSION_MAX_AGE_IN_SECONDS=86400
SMTP_FROM_ALT_RATIO_PERCENT=10
