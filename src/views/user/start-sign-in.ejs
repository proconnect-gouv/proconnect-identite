<div>
    <%- include('../partials/notifications.ejs', {notifications: notifications, noWrapperDiv: true}) %>
    <h1 class="fr-h3">
        S’inscrire ou se connecter
    </h1>
    <div>
        <div class="fr-alert fr-alert--warning fr-mb-3w">
            <h2 class="fr-alert__title">Maintenance de sécurité</h2>
            <p>
                Une maintenance de sécurité de notre hébergeur est prévue du <b>21 octobre à 15h au 26 octobre à 12h</b>.
                Des
                interruptions temporaires de ProConnect peuvent survenir pendant cette période et vous empêcher de vous
                connecter. En cas de difficulté, veuillez réessayer ultérieurement.
            </p>
        </div>
        <% if(locals.displayTestEnvWarning) { %><%- include('../partials/test-env-warning.ejs') %>
        <% } %>
        <form action="/users/start-sign-in" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken; %>">

            <div class="fr-input-group <% if (locals.hasEmailError) { %>  fr-input-group--error<% } %>">
                <label class="fr-label" for="did-you-mean-input">Email professionnel
                    <span class="fr-hint-text">Format attendu : nom@domaine.fr</span>
                </label>
                <input
                        id="did-you-mean-input"
                        class="fr-input"
                        required type="email" name="login"
                        autocomplete="email"
                <% if (!locals.loginHint) { %>
                        autofocus
                <% } else { %>
                        value="<%= locals.loginHint; %>"
                <% } %>
                <% if (locals.hasEmailError) { %>
                        autofocus
                        aria-describedby="email-error"
                <% } %>
                >
                <% if (locals.hasEmailError) { %>
                    <p class="fr-error-text" id="email-error" role="alert">
                        Adresse email invalide.
                    </p>
                <% } %>
                <% if (locals.didYouMean) { %>
                    <p id="did-you-mean-element" class="fr-info-text">
                        <span>
                        Vouliez-vous dire
                        <a id="did-you-mean-link" href="#" title="<%= locals.didYouMean %> (cliquer pour remplir le champ)"><%= locals.didYouMean %></a> ?
                        </span>
                    </p>
                    <script type="module" src="<%= js('did-you-mean.js') %>"></script>
                <% } %>
            </div>
            <%- include('../partials/submit-button.ejs', {label: 'Continuer'}) %>
        </form>
        <%- include('../partials/go-back.ejs') %>
    </div>
</div>
