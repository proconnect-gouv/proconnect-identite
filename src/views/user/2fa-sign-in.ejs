<div>
    <%- include('../partials/notifications.ejs', {notifications: notifications, noWrapperDiv: true}) %>
    <div class="fr-alert fr-alert--error fr-mb-2w" id="webauthn-alert-error" hidden></div>
    <div class="fr-alert fr-alert--success fr-mb-2w" id="webauthn-alert-success" hidden></div>
    <h1 class="fr-h3">
        Étape de connexion renforcée
    </h1>
    <div class="fr-notice fr-notice--info notice--change-email fr-mb-2w">
        <div class="fr-container">
            <p class="fr-notice__body">
                <span class="fr-sr-only">Votre email :</span>
                <strong><%= email; %></strong>
                <a
                    class="fr-btn fr-btn--close"
                    title="Changer d’adresse email"
                    href="/users/start-sign-in"
                    id="change-email-address"
                >
                    Changer d’adresse email
                </a>
            </p>
        </div>
    </div>
    <% if (showsTotpSection) { %>
        <p class="text--medium">
            Lors de la création de votre compte, vous avez configuré une application pour générer vos codes de sécurité (TOTP).
        </p>
        <p class="text--medium">Ouvrez votre application, puis saisissez le code affiché pour ProConnect.</p>
        <div class="fr-alert fr-alert--info fr-mb-2w">
            <p>Ce code n'est pas généré par ProConnect et il ne vous est pas envoyé par SMS ni par email.</p>
        </div>
        <form action="/users/2fa-sign-in-with-totp" method="post" class="fr-mb-2w">
            <input type="hidden" name="_csrf" value="<%= csrfToken; %>" />
            <div class="fr-input-group<% if (locals.hasCodeError) { %>  fr-input-group--error<% } %> fr-mb-2w">
                <label class="fr-label" for="totpToken">
                    Saisissez le code à usage unique à 6 chiffres de votre application d'authentification
                </label>
                <input
                    id="totpToken"
                    class="fr-input"
                    type="text"
                    name="totpToken"
                    required
                    pattern="^(\s*\d){6}$"
                    title="code composé de 6 chiffres"
                    autocomplete="one-time-code"
                    autofocus
                    <% if (locals.hasCodeError) { %>
                    aria-describedby="email-error"
                    <% } %>
                >
                <% if (locals.hasCodeError) { %>
                    <p class="fr-error-text" id="email-error" role="alert">
                        Code invalide. 
                        <a href="https://proconnect.crisp.help/fr/article/quest-ce-que-la-double-authentification-1m5mpmj/#2-comment-faire-si-le-code-a-usage-unique-ne-fonctionne-pas"
                           target="_blank"
                           rel="noopener noreferrer"
                        >
                            Consultez notre page d’aide.
                        </a>
                    </p>
                <% } %>
            </div>
            <%- include('../partials/submit-button.ejs', {label: 'Continuer'}) %>
        </form>
        <div class="fr-background-alt--blue-france fr-p-1w fr-grid-row fr-grid-row--center fr-grid-row--middle">
            <span class="fr-icon-lightbulb-fill fr-mr-1w fr-text-action-high--blue-france" aria-hidden="true"></span>
            <a class="fr-link fr-link--sm" href="https://proconnect.crisp.help/fr/article/ou-trouver-mon-code-a-6-chiffres-pour-me-connecter-a-proconnect-1ikt15d/" target="_blank" rel="noopener noreferrer">
                Trouver mon code à 6 chiffres
            </a>
        </div>
    <% } %>
    <% if (showsTotpSection && showsPasskeySection) { %>
        <p class="fr-hr-or fr-mt-3w">ou</p>
    <% } %>

    <% if (showsPasskeySection) { %>
        <div>
            <p>
                Votre appareil vous demandera d'utiliser votre empreinte, votre visage ou
                le verrouillage de l'écran pour valider votre identité.
            </p>
            <button
                class="fr-btn btn--fullwidth fr-btn--secondary fr-btn--icon-left fr-icon-lock-unlock-line"
                id="webauthn-btn-begin-authentication"
            >
                Se connecter avec une clé d’accès
            </button>
        </div>
        <form id="webauthn-authentication-response-form" action="/users/2fa-sign-in-with-passkey" method="post" hidden>
            <input type="hidden" name="_csrf" value="<%= csrfToken; %>">
            <input type="hidden" name="webauthn_authentication_response_string" autocomplete="webauthn">
            <button type="submit" class="fr-btn"></button>
        </form>
        <script type="module" src="<%= js('webauthn-authentication.js') %>"></script>
    <% } %>
    <% if (showsRecoveryWordsSection) { %>
        <div class="fr-mt-3w fr-grid-row fr-grid-row--center">
            <a
                class="fr-btn fr-btn--tertiary-no-outline fr-btn--icon-left fr-icon-question-line"
                href="/users/recover-user-account"
            >
                <% if (showsTotpSection && showsPasskeySection) { %>
                    Vous n’avez pas accès à ces méthodes ?
                <% } else { %>
                    Vous n’avez pas accès à cette méthode ?
                <% } %>
            </a>
        </div>
    <% } %>
    <%- include('../partials/go-back.ejs') %>
</div>
